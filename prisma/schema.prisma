// Resale Dashboard — Prisma Schema (SQLite for local dev)
// Ported from Diggaj Realty (Resale-platform) so business logic/data semantics match 1:1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums replaced with String for SQLite (matches source project's convention)
// ─────────────────────────────────────────────
// Role: SELLER | BUYER | AGENT | BACKEND | ADMIN
// KycStatus: PENDING | APPROVED | REJECTED
// PropertyStatus: DRAFT | PENDING_VERIFICATION | LIVE | UNDER_CONTRACT | CLOSED | REJECTED
// SiteVisitOutcome: INTERESTED | NOT_INTERESTED (null = not yet decided)
// SellerPlan: BASIC | VERIFIED | VERIFIED_PLUS | ELITE
// OfferStatus: PENDING | ACCEPTED | REJECTED | COUNTERED
// DealStatus: IN_PROGRESS | CLOSED
// PropertyType: RESIDENTIAL | PLOT | COMMERCIAL

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String
  role               String // Role enum — primary role, used for staff dashboard access & display
  roles              String[] @default([]) // Full set of held roles. BUYER/SELLER are additive on the public API
  // (a seller can also hold BUYER) — AGENT/BACKEND/ADMIN stay single,
  // admin-provisioned roles and are never combined with another.
  isActive           Boolean  @default(true)
  avatarUrl          String?
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sellerKyc                   SellerKyc?
  propertiesAsSeller          Property[]                 @relation("SellerProperties")
  propertiesAsAgent           Property[]                 @relation("AgentProperties")
  offersAsBuyer               Offer[]                    @relation("BuyerOffers")
  dealsAsBuyer                Deal[]                     @relation("BuyerDeals")
  dealsAsSeller               Deal[]                     @relation("SellerDeals")
  dealsAsAgent                Deal[]                     @relation("AgentDeals")
  notifications               Notification[]
  shortlists                  Shortlist[]
  savedSearches               SavedSearch[]
  propertyViews               PropertyView[]
  visitsAsBuyer               SiteVisit[]                @relation("BuyerVisits")
  visitsAsAgent               SiteVisit[]                @relation("AgentVisits")
  feedbackSubmitted           Feedback[]
  offlineNegotiationsRecorded OfflineNegotiation[]       @relation("OfflineNegotiationsRecorded")
  paymentRequestsCreated      PaymentRequest[]           @relation("PaymentRequestsCreated")
  interestsAsBuyer            PropertyInterest[]         @relation("BuyerInterests")
  interestsAsAgent            PropertyInterest[]         @relation("AgentInterests")
  negotiationsAsBuyer         NegotiationSession[]       @relation("BuyerNegotiations")
  negotiationsAsSeller        NegotiationSession[]       @relation("SellerNegotiations")
  negotiationsAsAgent         NegotiationSession[]       @relation("AgentNegotiations")
  negotiationEventsRecorded   NegotiationEvent[]         @relation("NegotiationEventsRecorded")
  documentRequestsMade        DocumentRequest[]          @relation("DocumentRequestsMade")
  documentRequestsReceived    DocumentRequest[]          @relation("DocumentRequestsReceived")
  documentRequestsReviewed    DocumentRequest[]          @relation("DocumentRequestsReviewed")
  documentAccessReceived      DocumentAccessGrant[]      @relation("DocumentAccessReceived")
  documentAccessGranted       DocumentAccessGrant[]      @relation("DocumentAccessGranted")
  documentsOwned              DealDocument[]             @relation("DocumentsOwned")
  identityVerifications       DealIdentityVerification[] @relation("IdentityVerifications")
  dealSignatures              DealSignature[]            @relation("DealSignatures")

  @@map("users")
}

model SellerKyc {
  id        String   @id @default(cuid())
  userId    String   @unique
  idType    String // IdType enum
  idDocUrl  String?
  selfieUrl String?
  status    String   @default("PENDING") // KycStatus enum
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_kyc")
}

model Property {
  id             String    @id @default(cuid())
  sellerId       String
  agentId        String?
  type           String // PropertyType enum
  title          String
  description    String?
  location       String
  latitude       Float?
  longitude      Float?
  areaSqft       Float
  bhk            Int?
  askingPrice    Float
  unitsAvailable Int       @default(1) // stock: how many identical units of this property are available
  status         String    @default("DRAFT") // PropertyStatus enum
  plan           String    @default("BASIC") // SellerPlan enum
  requestedPlan  String? // Seller-initiated upgrade awaiting backend approval (and, later, payment) — null when there's no pending request
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Submitted through the no-signup public intake link rather than by an
  // authenticated seller — the seller record behind it is a placeholder with
  // no KYC on file, so reviewers should expect to verify contact info by hand.
  isPublicSubmission Boolean @default(false)
  // Who referred this seller/submission (optional, free text) — attribution
  // for word-of-mouth / agent referrals, not tied to any user account.
  referralName       String?

  // ── Structured location (for search/filtering) ──
  city     String?
  locality String?
  pincode  String?

  // ── Area breakdown (RERA mandates carpet area) ──
  carpetAreaSqft       Float?
  builtUpAreaSqft      Float?
  superBuiltUpAreaSqft Float?

  // ── Configuration ──
  bathrooms      Int?
  balconies      Int?
  furnishing     String? // UNFURNISHED | SEMI_FURNISHED | FULLY_FURNISHED
  facing         String? // N | S | E | W | NE | NW | SE | SW
  floorNumber    Int?
  totalFloors    Int?
  ageYears       Int? // age of property in years
  parkingCovered Int?    @default(0)
  parkingOpen    Int?    @default(0)

  // ── Legal / commercial ──
  possessionStatus   String? // READY_TO_MOVE | UNDER_CONSTRUCTION
  possessionDate     DateTime?
  ownershipType      String? // FREEHOLD | LEASEHOLD | POWER_OF_ATTORNEY | CO_OPERATIVE
  reraId             String?
  priceNegotiable    Boolean   @default(false)
  maintenanceMonthly Float?

  // ── Media & amenities ──
  floorPlanUrl String?
  videoUrl     String?
  amenities    String[] @default([])

  // ── Builder / project (Bangalore master list) ──
  builderName String?
  projectName String?

  // ── Engagement analytics ──
  viewCount Int @default(0)

  seller User  @relation("SellerProperties", fields: [sellerId], references: [id])
  agent  User? @relation("AgentProperties", fields: [agentId], references: [id])

  photos              PropertyPhoto[]
  offers              Offer[]
  // A list, not a single deal: a sale that falls through leaves its record
  // behind and the property can be re-attempted. Only one may be active at a
  // time — enforced by Deal.activePropertyId.
  deals               Deal[]
  shortlists          Shortlist[]
  views               PropertyView[]
  siteVisits          SiteVisit[]
  interests           PropertyInterest[]
  negotiationSessions NegotiationSession[]

  @@index([city])
  @@index([status])
  @@map("properties")
}

model PropertyPhoto {
  id         String @id @default(cuid())
  propertyId String
  photoUrl   String
  mediaType  String @default("IMAGE") // IMAGE | VIDEO
  order      Int    @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model Offer {
  id            String   @id @default(cuid())
  propertyId    String
  buyerId       String
  amount        Float
  message       String?
  status        String   @default("PENDING_REVIEW") // OfferStatus enum: PENDING_REVIEW | PENDING | ACCEPTED | REJECTED | COUNTERED
  counterAmount Float?
  counterBy     String? // 'BACKEND' | 'SELLER' — who issued the current counterAmount
  reviewedBy    String? // backend user id who forwarded/countered/rejected this negotiation
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer    User         @relation("BuyerOffers", fields: [buyerId], references: [id])
  events   OfferEvent[]

  @@map("offers")
}

model OfferEvent {
  id        String   @id @default(cuid())
  offerId   String
  type      String // CREATED | FORWARDED | COUNTERED_BACKEND | COUNTERED_SELLER | ACCEPTED | REJECTED | COUNTER_ACCEPTED | COUNTER_REJECTED
  amount    Float?
  actorId   String?
  actorRole String?
  note      String?
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_events")
}

model Deal {
  id         String @id @default(cuid())
  propertyId String
  /// Mirrors propertyId for as long as this deal holds the property, and is
  /// NULLed the moment it falls through. Postgres allows many NULLs in a unique
  /// index, so this enforces "one *active* deal per property" while still
  /// letting a collapsed sale be re-attempted — propertyId alone used to be
  /// @unique, which meant one failed deal locked the listing out of ever being
  /// sold again. Guards that ask "is this property already spoken for?" look
  /// this up rather than propertyId, and still get a P2002 on a genuine race.
  activePropertyId String? @unique

  buyerId          String
  sellerId         String
  agentId          String?
  agreedPrice      Float
  tokenAmount      Float?
  tokenDate        DateTime?
  finalAmount      Float?
  finalPaymentDate DateTime?
  paymentMode      String? // BANK_TRANSFER | CHEQUE | OTHER
  transactionRef   String?
  notes            String?
  commissionAmount Float?
  status           String    @default("IN_PROGRESS") // IN_PROGRESS | CLOSED | FELL_THROUGH
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Stage declared by staff, for coordination work the platform cannot observe
  /// (a call happened, a price was agreed in person). Only ever moves the
  /// reported stage *forward* of what the records prove, and only as far as a
  /// SOFT stage — see resolveDealStage in src/lib/data/dealProgress.ts. Null
  /// means "whatever the evidence says".
  manualStage String?

  // ── Collapse (FELL_THROUGH) — loan rejected, buyer walked, seller backed out.
  // Kept as a record rather than deleted: it is the honest history of the
  // property and the source of why-we-lose reporting.
  failedAt     DateTime?
  failureCode  String? // BUYER_WITHDREW | SELLER_WITHDREW | FINANCING_DENIED | LEGAL_TITLE_ISSUE | PRICE_DISPUTE | UNRESPONSIVE | OTHER
  failureNote  String?
  failedBy     String? // user id of the staff member who recorded it

  property              Property                   @relation(fields: [propertyId], references: [id])
  buyer                 User                       @relation("BuyerDeals", fields: [buyerId], references: [id])
  seller                User                       @relation("SellerDeals", fields: [sellerId], references: [id])
  agent                 User?                      @relation("AgentDeals", fields: [agentId], references: [id])
  documents             DealDocument[]
  logEntries            DealLogEntry[]
  siteVisit             SiteVisit?
  offlineNegotiations   OfflineNegotiation[]
  paymentRequests       PaymentRequest[]
  negotiationSessions   NegotiationSession[]
  documentRequests      DocumentRequest[]
  documentAccessGrants  DocumentAccessGrant[]
  identityVerifications DealIdentityVerification[]
  agreements            DealAgreement[]
  stageChanges          DealStageChange[]
  costSheets            CostSheet[]

  // propertyId lost its @unique to activePropertyId above, so it needs an index
  // of its own — "every deal ever attempted on this property" is a common read.
  @@index([propertyId])
  @@index([status])
  @@map("deals")
}

/// Every hand-made move of a deal's stage, forward or back.
///
/// Kept because a manually-set stage is a *claim* rather than an observation:
/// the buyer and seller see the progress bar move, so who moved it, when, and
/// why has to be answerable months later. A stage that walks backwards is the
/// case this exists for — without the trail, "it said documentation complete
/// last week" is unresolvable.
model DealStageChange {
  id        String   @id @default(cuid())
  dealId    String
  /// Effective stage before and after. `fromStage` is what was displayed, which
  /// may have been derived rather than declared — that is the thing that
  /// visibly changed.
  fromStage String
  toStage   String
  direction String // FORWARD | BACKWARD
  reason    String?
  actorId   String
  actorRole String
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_stage_changes")
}

// ── Deal progress log — free-text, dated updates on how the paperwork/
// closing process is going, posted by agent/backend/admin. Distinct from
// Deal.notes (a single overwritable field) and from DealDocument (structured,
// per-document checklist) — this is the running "here's what's happening"
// timeline both buyer and seller can read. ──

model DealLogEntry {
  id         String   @id @default(cuid())
  dealId     String
  authorId   String
  authorRole String
  message    String
  createdAt  DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_log_entries")
}

// ── Deal closure document checklist ──

model DealDocument {
  id           String   @id @default(cuid())
  dealId       String
  docType      String // e.g. SALE_DEED, NOC, ENCUMBRANCE_CERTIFICATE, KHATA, TAX_RECEIPT, OTHER — free text, no rigid enum
  requiredFrom String // BUYER | SELLER | EITHER — whose responsibility to upload it
  fileUrl      String?
  status       String   @default("PENDING") // PENDING | UPLOADED | APPROVED | REJECTED
  remarks      String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// The party this document belongs to. Distinct from uploadedBy: ownership
  /// determines who may see it by default and who must consent before the
  /// counterparty gets access, and it survives even before anything is uploaded.
  ownerId String?

  deal         Deal                  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  owner        User?                 @relation("DocumentsOwned", fields: [ownerId], references: [id])
  accessGrants DocumentAccessGrant[]
  sharedFor    DocumentRequest[]

  @@index([dealId])
  @@index([ownerId])
  @@map("deal_documents")
}

/// A genuine buyer lead on a property — the early-stage object that exists
/// *before* any formal Offer. Saving/shortlisting a property, asking to be
/// contacted, or requesting a visit are all interest, not offers, and must not
/// create an Offer or Deal. Shortlist stays what it is (a bookmark); this is the
/// operational lead the agent works.
model PropertyInterest {
  id         String  @id @default(cuid())
  propertyId String
  buyerId    String
  /// The agent actually responsible for THIS buyer lead. Seeded from
  /// Property.agentId when one exists, but tracked separately because the same
  /// property can have many buyer interests with different owners.
  agentId    String?

  status String @default("NEW")
  // NEW | CONTACT_REQUESTED | AGENT_ASSIGNED | CONTACT_IN_PROGRESS
  // SITE_VISIT_REQUESTED | SITE_VISIT_SCHEDULED | SITE_VISIT_COMPLETED
  // INTERESTED | NOT_INTERESTED | NEGOTIATION_IN_PROGRESS
  // CONVERTED_TO_DEAL | CLOSED | CANCELLED

  source    String? // SHORTLIST | CONTACT_REQUEST | SITE_VISIT_REQUEST | GENERAL_INTEREST | OTHER
  buyerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer    User     @relation("BuyerInterests", fields: [buyerId], references: [id], onDelete: Cascade)
  agent    User?    @relation("AgentInterests", fields: [agentId], references: [id])

  siteVisits          SiteVisit[]
  negotiationSessions NegotiationSession[]

  @@unique([propertyId, buyerId])
  @@index([propertyId])
  @@index([buyerId])
  @@index([agentId])
  @@index([status])
  @@map("property_interests")
}

/// An agent-mediated negotiation, usually conducted by phone or in person.
///
/// This is the default real-estate path: the agent talks to both sides and
/// records what each party's position is as it moves. Deliberately separate from
/// Offer/OfferEvent, which is the platform's own online negotiation — both can
/// exist for the same property and neither overwrites the other.
///
/// Critically, an agent recording "both parties agreed" is NOT agreement. The
/// buyer and seller each confirm for themselves (buyerConfirmed /
/// sellerConfirmed), and only both together let this reach AGREED and become a
/// Deal. See src/lib/data/negotiations.ts.
model NegotiationSession {
  id         String  @id @default(cuid())
  propertyId String
  interestId String?
  /// Set once this negotiation has produced a Deal — the link back to it.
  dealId     String?

  buyerId  String
  sellerId String
  agentId  String

  channel String // PHONE | IN_PERSON | ONLINE | OTHER

  status String @default("OPEN")
  // OPEN | AGREEMENT_PENDING_CONFIRMATION | AGREED | FAILED | CANCELLED

  /// Confirmations are per-party and may only be set by that party. An agent
  /// cannot tick either of these on someone's behalf.
  buyerConfirmed  Boolean @default(false)
  sellerConfirmed Boolean @default(false)

  /// The amount currently on the table for confirmation. Both parties must
  /// confirm this same figure; changing it resets both confirmations.
  proposedAmount    Float?
  /// Locked in once both parties have confirmed.
  finalAgreedAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  interest PropertyInterest? @relation(fields: [interestId], references: [id])
  deal     Deal?             @relation(fields: [dealId], references: [id])
  buyer    User              @relation("BuyerNegotiations", fields: [buyerId], references: [id])
  seller   User              @relation("SellerNegotiations", fields: [sellerId], references: [id])
  agent    User              @relation("AgentNegotiations", fields: [agentId], references: [id])

  events NegotiationEvent[]

  @@index([propertyId])
  @@index([interestId])
  @@index([dealId])
  @@index([agentId])
  @@index([status])
  @@map("negotiation_sessions")
}

/// One immutable step in an agent-mediated negotiation — a position, a counter,
/// a note, a confirmation. Append-only: the history is the point, so nothing
/// here is ever updated or deleted.
model NegotiationEvent {
  id        String @id @default(cuid())
  sessionId String
  actorId   String
  actorRole String // BUYER | SELLER | AGENT | BACKEND | ADMIN

  eventType String
  // BUYER_POSITION | SELLER_POSITION | AGENT_NOTE | BUYER_COUNTER
  // SELLER_COUNTER | PRICE_PROPOSED | BUYER_CONFIRMED | SELLER_CONFIRMED
  // AGREEMENT_REACHED | NEGOTIATION_FAILED | CONFIRMATIONS_RESET

  amount Float?
  note   String?

  createdAt DateTime @default(now())

  session NegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actor   User               @relation("NegotiationEventsRecorded", fields: [actorId], references: [id])

  @@index([sessionId])
  @@map("negotiation_events")
}

/// Negotiation that happened off-platform — in person, by phone, or through the
/// agent — recorded after the fact by the assigned agent. Deliberately separate
/// from Offer/OfferEvent: that timeline is the platform's own negotiation record
/// and must stay intact, while this captures what was agreed in the real world.
model OfflineNegotiation {
  id           String @id @default(cuid())
  dealId       String
  agreedAmount Float

  /// Confirmations may ONLY be set by the party they belong to. Staff used to
  /// tick these on the parties' behalf, which made "the buyer agreed to ₹1.7 Cr"
  /// a claim by the agent rather than by the buyer — the same asymmetry the
  /// online offer flow was built to avoid. Recording what was agreed is staff
  /// work; confirming it is not.
  buyerConfirmed  Boolean   @default(false)
  sellerConfirmed Boolean   @default(false)
  buyerActedAt    DateTime?
  sellerActedAt   DateTime?

  /// Set when a party says the recorded figure is wrong. A disputed record
  /// blocks the deal's stage from advancing until it is resolved — paperwork
  /// must not roll on over an unresolved disagreement about the price.
  disputedBy    String? // BUYER | SELLER
  disputedNote  String?
  disputedAt    DateTime?
  /// Ends the dispute. The amount can also be corrected instead, which clears
  /// the dispute and resets both confirmations.
  resolvedAt    DateTime?
  supersededAt  DateTime?

  notes        String?
  recordedById String // the agent (or staff member) who recorded it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deal       Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  recordedBy User @relation("OfflineNegotiationsRecorded", fields: [recordedById], references: [id])

  @@index([dealId])
  @@map("offline_negotiations")
}

/// A full breakdown of what the buyer actually pays, sent to them by the deal's
/// agent or by backend.
///
/// Structured line items rather than an uploaded PDF, for three reasons: the
/// buyer can query one line instead of the whole document, the total can be
/// checked against the confirmed negotiated price rather than quietly
/// disagreeing with it, and the numbers stay reportable. The formal signed copy
/// can still be attached as a DealDocument alongside this.
model CostSheet {
  id      String @id @default(cuid())
  dealId  String
  /// Sending freezes a sheet. Editing a sent sheet supersedes it with a new
  /// version rather than mutating it, so a figure the buyer already acknowledged
  /// can never be quietly altered underneath them.
  version Int    @default(1)
  status  String @default("DRAFT") // DRAFT | SENT | SUPERSEDED

  authorId String
  sentAt   DateTime?

  /// Buyer acknowledgement, or a query naming the line they dispute. Mirrors the
  /// offline-negotiation pattern deliberately: same shape, same expectations.
  acknowledgedAt DateTime?
  queriedAt      DateTime?
  queryNote      String?
  queriedLineId  String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal  Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lines CostSheetLine[]

  @@index([dealId])
  @@map("cost_sheets")
}

model CostSheetLine {
  id          String @id @default(cuid())
  costSheetId String
  label       String
  amount      Float
  /// PROPERTY_PRICE | CHARGE | TAX | STATUTORY | DEDUCTION
  ///
  /// Exactly one PROPERTY_PRICE line is expected, and it must match the
  /// confirmed negotiated amount — see reconcileCostSheet. STATUTORY covers
  /// stamp duty and registration, which are shown as estimates: they vary by
  /// sub-registrar office and move with circle rates, so presenting them as
  /// firm quotes would have buyers budgeting off a number the platform cannot
  /// stand behind.
  category    String
  note        String?
  /// Off by default. Brokerage and internal margin live on the same sheet as
  /// the buyer's charges, and a default of "shared" would leak them the first
  /// time someone forgot to untick it.
  sharedWithBuyer Boolean @default(false)
  order           Int     @default(0)

  costSheet CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  @@index([costSheetId])
  @@map("cost_sheet_lines")
}

/// A request for money that surfaces on the buyer's or seller's own dashboard
/// with a "Pay Now" action. Separate from Deal.tokenAmount/finalAmount, which are
/// staff-recorded records of payments that already happened elsewhere.
model PaymentRequest {
  id          String    @id @default(cuid())
  dealId      String
  recipient   String // BUYER | SELLER — who owes this
  amount      Float
  /// What this money is for. Structured so payments can be reconciled and
  /// reported on, rather than a wall of "Payment: ₹5,00,000" rows that nobody
  /// can interpret later. Free-text title/description still carry the detail.
  purpose     String? // TOKEN | REGISTRATION | STAMP_DUTY | DOCUMENTATION | FINAL_SETTLEMENT | COMMISSION | OTHER
  title       String?
  description String?
  dueDate     DateTime?
  // PENDING | PAYMENT_INITIATED | PAID | FAILED | CANCELLED. The backend is the
  // only thing that may set PAID — a frontend success screen is not proof.
  status      String    @default("PENDING")
  paidAt      DateTime?
  paymentRef  String? // gateway reference, populated once Razorpay is wired up
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deal      Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy User @relation("PaymentRequestsCreated", fields: [createdById], references: [id])

  @@index([dealId])
  @@map("payment_requests")
}

/// Per-party identity verification for a transaction.
///
/// Deliberately distinct from SellerKyc and from uploading an ID document.
/// Uploading a scan of an Aadhaar card is not verification of identity, and
/// neither is being verified the same as having signed anything. Each is its own
/// state with its own evidence, and this one is per-deal because verification is
/// scoped to the transaction, not to the account forever.
model DealIdentityVerification {
  id     String @id @default(cuid())
  dealId String
  userId String

  method String // KYC_PROVIDER | AADHAAR_OTP | OTHER_COMPLIANT_METHOD

  status String @default("PENDING")
  // PENDING | INITIATED | VERIFIED | FAILED | EXPIRED

  /// The external provider's own reference, so a VERIFIED claim can be traced
  /// back to evidence outside this system.
  providerReference String?
  remarks           String?
  verifiedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation("IdentityVerifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([dealId])
  @@map("deal_identity_verifications")
}

/// The generated agreement for a deal, versioned.
///
/// A signed agreement is never overwritten: changing the terms means a new
/// version and a fresh signature round, so the executed document that the
/// parties actually signed stays exactly as it was.
model DealAgreement {
  id      String @id @default(cuid())
  dealId  String
  version Int    @default(1)

  status String @default("DRAFT")
  // DRAFT | READY_FOR_SIGNATURE | SIGNING_IN_PROGRESS
  // PARTIALLY_SIGNED | FULLY_EXECUTED | EXPIRED | CANCELLED

  documentUrl String?
  /// Hash of the document as generated, so what gets signed can be proven to be
  /// what was presented.
  checksum    String?

  agreedAmount Float?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deal       Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  signatures DealSignature[]

  @@unique([dealId, version])
  @@index([dealId])
  @@map("deal_agreements")
}

/// One party's signature on one agreement version.
///
/// Only a verified provider callback may move this to SIGNED. An agent may
/// initiate and chase signing but must never be able to mark it done — "the user
/// clicked sign" is not evidence that a legally binding signature exists.
model DealSignature {
  id          String @id @default(cuid())
  agreementId String
  userId      String
  role        String // BUYER | SELLER

  status String @default("PENDING")
  // PENDING | INITIATED | SIGNED | FAILED | EXPIRED

  provider          String?
  providerReference String?
  signedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreement DealAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user      User          @relation("DealSignatures", fields: [userId], references: [id])

  @@unique([agreementId, userId])
  @@index([agreementId])
  @@map("deal_signatures")
}

/// A request from one party for a document held by the other — "I need to see
/// the seller's Aadhaar".
///
/// Never a direct channel between buyer and seller: every request lands on the
/// agent first, who decides whether it's legitimate. The agent can reject it,
/// forward it to the owner to upload something new, or — if the owner has
/// already had that document approved — grant access to the existing file
/// instead of asking for it again.
model DocumentRequest {
  id     String @id @default(cuid())
  dealId String

  requestedById   String
  requestedFromId String
  /// The agent who must review this before it reaches the other party.
  agentId         String?

  docType String
  reason  String?

  status String @default("PENDING_AGENT_REVIEW")
  // PENDING_AGENT_REVIEW | REJECTED | FORWARDED_TO_OWNER
  // EXISTING_DOCUMENT_SHARED | OWNER_UPLOADED | APPROVED | COMPLETED | CANCELLED

  /// Set when the agent satisfied this request by sharing an already-approved
  /// document, or when forwarding created a new DealDocument to be filled.
  sourceDocumentId String?

  /// Why the agent rejected it — required on rejection, so a refusal is never
  /// silent.
  reviewRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal           Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  requestedBy    User          @relation("DocumentRequestsMade", fields: [requestedById], references: [id])
  requestedFrom  User          @relation("DocumentRequestsReceived", fields: [requestedFromId], references: [id])
  agent          User?         @relation("DocumentRequestsReviewed", fields: [agentId], references: [id])
  sourceDocument DealDocument? @relation(fields: [sourceDocumentId], references: [id])

  @@index([dealId])
  @@index([status])
  @@index([requestedFromId])
  @@map("document_requests")
}

/// Explicit permission for someone other than the owner to see a document.
///
/// The counterparty gets no access to a deal's documents by default — this is
/// the only thing that opens one up, and it's revocable. Sharing grants access
/// to the existing file rather than copying it, so the original party stays the
/// owner and there's exactly one copy to audit.
model DocumentAccessGrant {
  id          String  @id @default(cuid())
  documentId  String
  dealId      String
  grantedToId String
  grantedById String
  purpose     String?
  status      String  @default("ACTIVE") // ACTIVE | REVOKED

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  document  DealDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  grantedTo User         @relation("DocumentAccessReceived", fields: [grantedToId], references: [id])
  grantedBy User         @relation("DocumentAccessGranted", fields: [grantedById], references: [id])

  @@unique([documentId, grantedToId, dealId])
  @@index([dealId])
  @@index([grantedToId])
  @@map("document_access_grants")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AppConfig {
  id                      String   @id @default("singleton")
  commissionPercent       Float    @default(2)
  kycAutoApproveEnabled   Boolean  @default(false)
  listingApprovalRequired Boolean  @default(true)
  supportEmail            String?
  updatedAt               DateTime @updatedAt

  // ── Listing / plan config ──
  maxPhotosPerListing Int   @default(15)
  verifiedPlanPrice   Float @default(0)
  elitePlanPrice      Float @default(0)

  // ── Feature toggles ──
  siteVisitsEnabled Boolean @default(true)
  savedSearchAlerts Boolean @default(true)

  // ── Deal closure requirements ──
  // What must be true before a deal can close. Configurable rather than
  // hard-coded because the legal/commercial bar differs by deal type and
  // jurisdiction, and because identity verification and e-signing are being
  // rolled out — forcing them on every in-flight deal would strand the ones
  // already mid-paperwork. Document approval defaults on (it always applied).
  closureRequiresDocuments Boolean @default(true)
  closureRequiresIdentity  Boolean @default(false)
  closureRequiresAgreement Boolean @default(false)
  closureRequiresPayments  Boolean @default(false)

  @@map("app_config")
}

// ── Buyer engagement ──

model Shortlist {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@map("shortlists")
}

model SavedSearch {
  id            String    @id @default(cuid())
  userId        String
  name          String?
  filters       Json // { q?, type?, city?, minPrice?, maxPrice?, minBhk?, ... }
  alertsEnabled Boolean   @default(true)
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

model PropertyView {
  id         String   @id @default(cuid())
  userId     String?
  propertyId String
  createdAt  DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([propertyId])
  @@map("property_views")
}

// ── Site visits / agent CRM ──

model SiteVisit {
  id            String    @id @default(cuid())
  propertyId    String
  buyerId       String
  agentId       String?
  status        String    @default("REQUESTED") // REQUESTED | SCHEDULED | COMPLETED | CANCELLED
  requestedDate DateTime
  scheduledDate DateTime?
  buyerNote     String?
  feedback      String? // post-visit notes by agent
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Post-visit outcome — negotiation happens in person on the visit itself,
  // never online, so this just records what was agreed. outcome/
  // interestedAmount can be updated repeatedly (further in-person rounds)
  // right up until a Deal is created from this visit. dealId is set once
  // converted, so the same visit can't spawn a second Deal.
  outcome          String? // INTERESTED | NOT_INTERESTED | FOLLOW_UP_REQUIRED
  interestedAmount Float?
  dealId           String? @unique

  /// The lead this visit belongs to. Nullable for backward compatibility —
  /// visits created before interests existed (and the direct buyer-requests-a-
  /// visit path) have none, and must keep working.
  interestId String?

  /// A date put forward but not yet agreed, and who put it forward. Either side
  /// can propose: the buyer asking for a slot, or the agent offering one. The
  /// other party then accepts, declines, or proposes a different time, so
  /// `proposedBy` is effectively "whose move it isn't" — the same turn-taking
  /// shape as negotiation confirmations. Cleared once a date is agreed
  /// (scheduledDate) so a stale proposal can't linger next to a live booking.
  proposedDate DateTime?
  proposedBy   String? // BUYER | AGENT

  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer    User              @relation("BuyerVisits", fields: [buyerId], references: [id], onDelete: Cascade)
  agent    User?             @relation("AgentVisits", fields: [agentId], references: [id])
  deal     Deal?             @relation(fields: [dealId], references: [id])
  interest PropertyInterest? @relation(fields: [interestId], references: [id])

  @@index([buyerId])
  @@index([agentId])
  @@index([status])
  @@index([interestId])
  @@map("site_visits")
}

// ── Internal staff feedback ──

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("GENERAL") // GENERAL | BUG | FEATURE_REQUEST
  message   String
  status    String   @default("OPEN") // OPEN | REVIEWED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedback")
}

// ── Admin masters ──

model Amenity {
  id       String  @id @default(cuid())
  name     String  @unique
  category String? // e.g. "Building", "Security", "Recreation"
  active   Boolean @default(true)

  @@map("amenities")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
