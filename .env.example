# ── Database (Supabase Postgres) ──────────────────────────────────────────
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────
# Random 32+ char secret. Generate with: openssl rand -base64 32
# Signs both NextAuth session cookies AND the /api/v1 bearer JWTs.
NEXTAUTH_SECRET="change-me"
# Canonical URL of THIS deployment (the dashboard/API host).
# Local: http://localhost:3000 · Prod: https://<your-app>.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Supabase Storage (file uploads) ───────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
# Service-role key (server-only, never exposed to the browser) — lets the API
# upload to the property-media / kyc-documents / deal-documents buckets.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Public client config (safe to expose).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# ── Google Maps/Places (property location preview) ────────────────────────
# Static Maps images are rendered client-side, so this must be NEXT_PUBLIC —
# restrict it to your domain(s) in the Google Cloud Console, not by secrecy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="<google-maps-api-key>"

# ── Google Sign-In (OAuth) ─────────────────────────────────────────────────
# From a Google Cloud Console OAuth 2.0 Client ID (Web application type).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# Used for BOTH the internal dashboard's NextAuth login AND the public
# /api/v1/auth/google token-exchange endpoint (verifies the client ID as the
# token's audience) — same two credentials, no separate setup needed.
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"

# ── Unsplash (stock imagery) ───────────────────────────────────────────────
# From https://unsplash.com/oauth/applications — Your apps > <app> > Keys.
# Server-side only: the access key is enough for search/photo lookups via the
# `Authorization: Client-ID <access-key>` header. The secret key is ONLY for
# the OAuth user-authorization flow and must never reach the browser.
UNSPLASH_APPLICATION_ID="<unsplash-application-id>"
UNSPLASH_ACCESS_KEY="<unsplash-access-key>"
UNSPLASH_SECRET_KEY="<unsplash-secret-key>"

# ── WhatsApp delivery (optional) ────────────────────────────────────────────
# Unset or NONE means notifications stay in-app only; sends are logged, not
# dropped silently, so a missing provider is diagnosable. Only META is
# implemented — GUPSHUP and TWILIO are recognised names awaiting a decision.
#
# Business-initiated WhatsApp requires pre-approved templates; the ones this
# app sends are listed in src/lib/whatsapp.ts and must be registered with the
# provider under the same names before anything will deliver.
WHATSAPP_PROVIDER="NONE"
# META (WhatsApp Cloud API) — from the Meta app dashboard.
WHATSAPP_PHONE_NUMBER_ID="<meta-phone-number-id>"
WHATSAPP_ACCESS_TOKEN="<meta-permanent-access-token>"
